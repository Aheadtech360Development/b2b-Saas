{
  "expo": {
    "name": "PrintCoPilot",
    "slug": "printcopilot",
    "scheme": "printcopilot",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "co.printcopilot.app",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "co.printcopilot.app",
      "permissions": []
    },
    "extra": {
      "apiUrl": "https://b2b-saas-production.up.railway.app"
    },
    "plugins": [
      "expo-asset",
      "expo-font",
      "expo-splash-screen",
      "expo-secure-store",
      "expo-status-bar",
      "@stripe/stripe-react-native"
    ]
  }
}
